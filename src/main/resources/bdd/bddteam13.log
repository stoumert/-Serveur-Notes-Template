/*C2*/SET SCHEMA PUBLIC
CREATE TABLE IF NOT EXISTS teachers (id INTEGER IDENTITY PRIMARY KEY,name VARCHAR(255) NOT NULL,surname VARCHAR(255) NOT NULL )
CREATE TABLE IF NOT EXISTS students (id INTEGER IDENTITY PRIMARY KEY,name VARCHAR(25) NOT NULL,surname VARCHAR(25) NOT NULL)
CREATE TABLE IF NOT EXISTS courses (id INTEGER IDENTITY PRIMARY KEY,name VARCHAR(255) NOT NULL,description VARCHAR(255) NOT NULL,credits INTEGER NOT NULL,supervisor_id INTEGER NOT NULL,FOREIGN KEY (supervisor_id) REFERENCES teachers (id))
CREATE TABLE IF NOT EXISTS course_session (id INTEGER IDENTITY PRIMARY KEY,course_id INTEGER NOT NULL,year INTEGER NOT NULL,formula VARCHAR(255) NOT NULL,FOREIGN KEY (course_id) REFERENCES courses (id))
CREATE TABLE IF NOT EXISTS grades (student_id INTEGER NOT NULL,session_id INTEGER NOT NULL,grade_type VARCHAR(25) NOT NULL,grade DOUBLE NOT NULL,PRIMARY KEY (student_id,session_id,grade_type),FOREIGN KEY (student_id) REFERENCES students (id),FOREIGN KEY (session_id) REFERENCES course_session (id))
CREATE TABLE IF NOT EXISTS enrollment (student_id INTEGER NOT NULL,session_id INTEGER NOT NULL,PRIMARY KEY (student_id,session_id),FOREIGN KEY (student_id) REFERENCES students (id),FOREIGN KEY (session_id) REFERENCES course_session (id))
